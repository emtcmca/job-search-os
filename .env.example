# Base URL for OAuth callbacks.
# Local example: http://localhost:3000
# Hosted example later: https://your-app.vercel.app
APP_URL=http://localhost:3000

# Database:
# Local desktop mode can keep using a file path.
# Hosted mode should use a LibSQL URL plus an auth token.
# If DATABASE_URL is omitted on a hosted preview, the app falls back to ephemeral /tmp SQLite storage.
DATABASE_URL=data/job-search.sqlite
# DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=

# Gmail inbox integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FREELANCE_AI_PROVIDER=openai
FREELANCE_OPENAI_MODEL=gpt-4.1-mini
FREELANCE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
